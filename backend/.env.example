# ========================================
# FINAP Backend - Environment Variables
# ========================================

# Application
APP_NAME=FINAP API
APP_VERSION=1.0.0
DEBUG=True
ENV=development

# API
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Meta WhatsApp Business API
# Obtenha em: https://developers.facebook.com/apps
META_WHATSAPP_TOKEN=your-meta-access-token
META_WHATSAPP_PHONE_ID=your-phone-number-id
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_VERIFY_TOKEN=finap_webhook_verify_token_2025
META_WHATSAPP_FROM_NUMBER=+15551234567
